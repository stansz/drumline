{
  "name": "drumline",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "test": "vitest run",
    "test:sandbox": "node node_modules/vitest/vitest.mjs run --config vitest.sandbox.config.mjs",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "playtest": "node --import ./tools/playtest/resolve-ts.mjs tools/playtest/run.mjs",
    "playtest:report": "node --import ./tools/playtest/resolve-ts.mjs tools/playtest/report-cli.mjs",
    "playtest:sweep": "node --import ./tools/playtest/resolve-ts.mjs tools/playtest/sweep.mjs",
    "playtest:search": "node --import ./tools/playtest/resolve-ts.mjs tools/playtest/search-cli.mjs",
    "playtest:tiers": "node --import ./tools/playtest/resolve-ts.mjs tools/playtest/tiers-cli.mjs"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
